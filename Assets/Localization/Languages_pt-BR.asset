  - m_Id: 45956803429793792
    m_Localized: Aumenta o tamanho da habilidade
    m_Metadata:
      m_Items: []
  - m_Id: 45956803442376704
    m_Localized: Faz os inimigos mais lentos
    m_Metadata:
      m_Items: []
  - m_Id: 45956803442376705
    m_Localized: Aumenta o recuo
    m_Metadata:
      m_Items: []
  - m_Id: 45956803442376706
    m_Localized: "Aumenta a dura\xE7\xE3o da habilidade"
    m_Metadata:
      m_Items: []
  - m_Id: 45956803442376707
    m_Localized: Incendeia os inimigos por um tempo
    m_Metadata:
      m_Items: []
  - m_Id: 45956803442376708
    m_Localized: Aumenta o dano
    m_Metadata:
      m_Items: []
  - m_Id: 45956803442376709
    m_Localized: Rouba vida dos inimigos
    m_Metadata:
      m_Items: []
  - m_Id: 45960875390140416
    m_Localized: Cria uma zona que cura o jogador
    m_Metadata:
      m_Items: []
  - m_Id: 45960875570495488
    m_Localized: "Dispara uma zona de fogo. Quem entrar ser\xE1 incendiado!"
    m_Metadata:
      m_Items: []
  - m_Id: 45960875570495489
    m_Localized: "Dispara um proj\xE9til r\xE1pido e letal!"
    m_Metadata:
      m_Items: []
  - m_Id: 45960875570495490
    m_Localized: Atira dois esporos que congelam qualquer coisa que atingirem.
    m_Metadata:
      m_Items: []
  - m_Id: 45960875570495491
    m_Localized: Corte veloz e preciso
    m_Metadata:
      m_Items: []
  - m_Id: 45960875570495492
    m_Localized: "Permite colocar uma mina na posi\xE7\xE3o do mouse"
    m_Metadata:
      m_Items: []
  - m_Id: 45960875574689792
    m_Localized: "Avan\xE7a acertando tudo no caminho"
    m_Metadata:
      m_Items: []
  - m_Id: 45960875574689793
    m_Localized: Um escudo que bloqueia o dano
    m_Metadata:
      m_Items: []
